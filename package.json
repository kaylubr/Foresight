{
  "name": "foresight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "core",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n core,web -c blue,magenta \"npm:dev:core\" \"npm:dev:web\"",
    "dev:core": "npm run dev --workspace core",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run build && npm run start --workspace core",
    "test": "npm run test --workspace core",
    "typecheck": "npm run typecheck --workspace core && npm run typecheck --workspace web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
